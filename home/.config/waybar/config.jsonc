{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,

    "modules-left": ["custom/power", "sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/hidden-status", "custom/agents", "cpu", "memory", "pulseaudio", "sway/language", "custom/network", "battery"],

    "group/hidden-status": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": true
        },
        "modules": ["custom/status-expander", "disk", "custom/bluetooth", "custom/openvpn"]
    },

    "custom/status-expander": {
        "format": "",
        "tooltip-format": "More status indicators"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        },
        "format": "{name}"
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Power menu",
        "on-click": "/home/dimitar/.config/modals/power/menu.py"
    },

    "custom/openvpn": {
        "exec": "/home/dimitar/.config/modals/openvpn/status.py",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "on-click": "/home/dimitar/.config/modals/openvpn/manager.py"
    },

    "custom/network": {
        "exec": "/home/dimitar/.config/modals/network/status.py",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "on-click": "/home/dimitar/.config/modals/network/manager.py"
    },

    "custom/bluetooth": {
        "exec": "/home/dimitar/.config/modals/bluetooth/status.py",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "on-click": "/home/dimitar/.config/modals/bluetooth/manager.py"
    },

    "custom/agents": {
        "exec": "/home/dimitar/.config/modals/agents/status.py",
        "return-type": "json",
        "interval": 900,
        "signal": 8,
        "format": "{}",
        "on-click": "/home/dimitar/.config/modals/agents/panel.py"
    },

    "clock": {
        "interval": 60,
        "format": "{:%A  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  {volume}%",
        "format-icons": ["", "", ""],
        "tooltip-format": "Volume: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "/home/dimitar/.config/modals/audio/manager.py"
    },

    "battery": {
        "bat": "BAT0",
        "interval": 10,
        "on-click": "/home/dimitar/.config/modals/power/profile-selector.py",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-full": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}  •  {power:.1f} W"
    },

    "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "  {percentage_used}%",
        "tooltip-format": "{used} / {total} used"
    },

    "sway/language": {
        "format": "  {short}",
        "tooltip": false
    }
}
