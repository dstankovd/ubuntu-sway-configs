# Lock after 5 minutes, blank displays after 10, suspend after 15.
timeout 300 'swaylock -f'
timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
timeout 900 'systemctl suspend'

# Covers manual suspend, lid-close suspend, and loginctl lock requests.
before-sleep 'swaylock -f'
lock 'swaylock -f'
