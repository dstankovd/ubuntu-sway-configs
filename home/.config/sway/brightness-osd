#!/bin/sh

case "$1" in
    up)   brightnessctl set 10%+ >/dev/null ;;
    down) brightnessctl set 10%- >/dev/null ;;
    *)    exit 2 ;;
esac

# Machine-readable output is: device,class,current,percentage,max.
percent=$(brightnessctl -m | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }')

notify-send \
    --app-name="Brightness" \
    --icon="display-brightness-symbolic" \
    --expire-time=1500 \
    --hint="int:value:${percent}" \
    --hint="string:x-canonical-private-synchronous:brightness" \
    "Brightness" "${percent}%"
